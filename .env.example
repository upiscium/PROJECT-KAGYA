# Optional override for the configuration file path.
# KAGYA_CONFIG_PATH=config.yaml

# Runtime environment label used by the application configuration.
# KAGYA_ENV=development

# Required for debug, memory inspection, sleep, and adapter admin endpoints.
# KAGYA_ADMIN_TOKEN=change-me-local-admin-token

# Optional frontend mirror for local admin pages. Do not use for public deployments.
# NEXT_PUBLIC_KAGYA_ADMIN_TOKEN=change-me-local-admin-token
