# Copy to /etc/project-kagya/training-worker.env and restrict it to the worker user.
KAGYA_APP_DIR=/opt/project-kagya
KAGYA_CONFIG_PATH=/etc/project-kagya/training-worker.yaml

# Pin the worker to its dedicated GPU. CUDA reindexes this device as cuda:0.
CUDA_VISIBLE_DEVICES=1

# Set to 1 on NixOS when the project flake supplies CUDA runtime libraries.
KAGYA_WORKER_NIX_DEVELOP=0

# Optional model cache and credentials.
# HF_HOME=/var/lib/project-kagya/huggingface
# HF_TOKEN=replace-only-if-the-model-requires-authentication
