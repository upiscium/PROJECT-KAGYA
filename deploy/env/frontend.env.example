# Copy to /etc/project-kagya/frontend.env and restrict permissions to the service user.
NEXT_PUBLIC_API_BASE_URL=https://kagya.example.com
KAGYA_BACKEND_URL=http://127.0.0.1:8000

# Server-side only. This must match the backend service's KAGYA_ADMIN_TOKEN.
KAGYA_ADMIN_TOKEN=replace-with-long-random-token
