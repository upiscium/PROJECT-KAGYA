# Copy to /etc/project-kagya/frontend.env and restrict permissions to the service user.
# Browser-visible origin for the reverse proxy. For SSH-tunnel use, set this to
# the local tunnel URL you open in the browser, for example http://127.0.0.1:18080.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
KAGYA_BACKEND_URL=http://127.0.0.1:8000
