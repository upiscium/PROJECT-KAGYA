# Copy to /etc/project-kagya/frontend.env and restrict permissions to the service user.
NEXT_PUBLIC_API_BASE_URL=https://kagya.example.com

# Local/private admin UI only. Values prefixed with NEXT_PUBLIC are visible in browser bundles.
# Do not expose admin pages publicly with this token-based setup.
NEXT_PUBLIC_KAGYA_ADMIN_TOKEN=replace-with-long-random-token
